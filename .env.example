# ----------------------------------------------------------------------------
# Nova platform environment configuration (example).
# Copy to `.env` and adjust. Never commit a real `.env`.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# ---- Database -------------------------------------------------------------
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL takes precedence over the individual POSTGRES_* values above.
DATABASE_URL=postgres://nova:nova_password@postgres:5432/nova
DB_SSL=false
DB_LOGGING=false

# ---- Orchestration-state database (postgres-agents) -----------------------
# Isolated from the business `nova` DB. The execution plane never connects to
# the business DB directly; all business reads/writes go through the API/MCP
# tools, which enforce per-user RBAC. The Node control plane owns this schema.
POSTGRES_AGENTS_DB=nova_agents
POSTGRES_AGENTS_USER=nova_agents
POSTGRES_AGENTS_PASSWORD=nova_agents_password
# Node (TypeORM) connection. The Python orchestrator uses a SQLAlchemy URL
# (postgresql+psycopg://...) to the same instance.
AGENTS_DATABASE_URL=postgres://nova_agents:nova_agents_password@postgres-agents:5432/nova_agents
AGENTS_DB_SSL=false

# ---- Redis (cache / rate limiting) ----------------------------------------
# Two separate instances for blast-radius isolation and independent scaling:
#   - redis-cache: backend-owned shared cache + cross-replica rate-limit store.
#   - redis-agent: reserved for the future Python A2A agents (no consumer yet).
# Provider-agnostic: point these at any managed Redis by changing the URL only.
# Use rediss:// (TLS) for any non-local/managed endpoint; redis:// is plaintext
# and must stay on a trusted private network (e.g. the local Docker bridge).
# The browser/SPA never connects to Redis directly (it cannot hold credentials);
# only the backend does.
REDIS_PASSWORD=nova_redis_password
REDIS_AGENT_PASSWORD=nova_redis_agent_password
# Backend connection URLs. Keep the embedded password in sync with the values
# above (or override the whole URL for a managed endpoint).
REDIS_CACHE_URL=redis://:nova_redis_password@redis-cache:6379
REDIS_AGENT_URL=redis://:nova_redis_agent_password@redis-agent:6379
# Dedicated Celery broker + result backend for the orchestration plane. Uses
# noeviction so queued/running task state is never silently dropped. Never
# published to the host; use rediss:// (TLS) for any non-local endpoint.
REDIS_ORCHESTRATOR_PASSWORD=nova_redis_orchestrator_password
CELERY_BROKER_URL=redis://:nova_redis_orchestrator_password@redis-orchestrator:6379/0
CELERY_RESULT_BACKEND=redis://:nova_redis_orchestrator_password@redis-orchestrator:6379/1
# When the rate-limit store is unreachable, allow requests through (true) rather
# than failing every request. Rate limiting is an availability control, not an
# authorization control. Set to false to fail closed.
REDIS_RATE_LIMIT_FAIL_OPEN=true

# ---- Seeding --------------------------------------------------------------
# When true, seeded data is deleted in dependency-safe order and reseeded.
# Only honoured outside production.
SEED_RESET=false

# ---- API ------------------------------------------------------------------
API_PORT=3000
# Comma-separated allowlist of browser origins permitted by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Max JSON body size accepted by the API.
API_BODY_LIMIT=100kb
# Sliding window rate limit (requests per window per client).
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# ---- Authentication (Keycloak / OIDC) -------------------------------------
# Issuer URL of the Keycloak realm. For local Docker this is the browser-facing
# URL so it matches the `iss` claim of tokens minted via http://localhost:8080.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/nova
# Expected token audience(s), comma-separated.
KEYCLOAK_AUDIENCE=nova-api
# Explicit JWKS URI. In Docker the API resolves Keycloak by service name, since
# `localhost` inside the API container is not the Keycloak container.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/nova/protocol/openid-connect/certs

# ---- Keycloak Admin REST (backend-driven user provisioning) ---------------
# The API provisions/syncs users + role mappings in Keycloak as the `nova-api`
# confidential client's service account (client_credentials). The browser never
# touches the Admin API. Provisioning is enabled only when a secret is set.
# Rotate KEYCLOAK_API_CLIENT_SECRET for any non-local environment.
KEYCLOAK_REALM=nova
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_API_CLIENT_ID=nova-api
KEYCLOAK_API_CLIENT_SECRET=nova-api-dev-secret

# ---- Orchestration plane (Celery + A2A) -----------------------------------
# The Node API enqueues work by ID only via the orchestrator task gateway,
# minting an audience-restricted nova-orchestrator service token. No broker
# credentials and no user tokens ever reach the API->orchestrator hop.
ORCHESTRATOR_BASE_URL=http://orchestrator:8001
ORCHESTRATOR_AUDIENCE=nova-orchestrator
# How long an async run may keep acting for the user (bounds the immutable
# entitlement snapshot), independent of the user's short-lived access token.
AGENT_RUN_TTL_SECONDS=7200
# Keycloak token endpoint used by services minting client_credentials tokens.
KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/nova/protocol/openid-connect/token
# Per-service confidential clients (least privilege, separate credentials).
# Rotate every secret for any non-local environment.
ORCHESTRATOR_CLIENT_ID=nova-orchestrator
ORCHESTRATOR_CLIENT_SECRET=nova-orchestrator-dev-secret
WORKER_CLIENT_ID=nova-celery-worker
WORKER_CLIENT_SECRET=nova-celery-worker-dev-secret
# Internal MCP tool gateway: the worker reaches the Node control plane here with
# an audience-restricted (nova-mcp-*) service token; the gateway re-enforces the
# entitlement snapshot before running any business operation.
NOVA_API_INTERNAL_URL=http://api:3000
INTERNAL_TOOL_GATEWAY_AUDIENCE=nova-mcp-sales
INTERNAL_TOOL_GATEWAY_AZP=nova-celery-worker
# Bounds per run (defense in depth against runaway plans).
MAX_RUN_STEPS=8
# Dev-only webhook HMAC signing secret. In production resolve per-owner secrets
# from a managed secret store via the webhook_auth_configs.*_secret_ref columns.
WEBHOOK_HMAC_SECRET=

# ---- Keycloak (local dev container) ---------------------------------------
# Bootstrap admin for the local Keycloak container ONLY. Never reuse in prod.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- Frontend (Vite, build-time) ------------------------------------------
# Only VITE_-prefixed values are inlined into the browser bundle. Never put
# Keycloak admin credentials or backend secrets here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=nova
VITE_KEYCLOAK_CLIENT_ID=nova-frontend
VITE_APP_NAME=Nova
