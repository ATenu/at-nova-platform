# ----------------------------------------------------------------------------
# Nova platform environment configuration (example).
# Copy to `.env` and adjust. Never commit a real `.env`.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# ---- Database -------------------------------------------------------------
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL takes precedence over the individual POSTGRES_* values above.
DATABASE_URL=postgres://nova:nova_password@postgres:5432/nova
DB_SSL=false
DB_LOGGING=false

# ---- Redis (cache / rate limiting) ----------------------------------------
# Two separate instances for blast-radius isolation and independent scaling:
#   - redis-cache: backend-owned shared cache + cross-replica rate-limit store.
#   - redis-agent: reserved for the future Python A2A agents (no consumer yet).
# Provider-agnostic: point these at any managed Redis by changing the URL only.
# Use rediss:// (TLS) for any non-local/managed endpoint; redis:// is plaintext
# and must stay on a trusted private network (e.g. the local Docker bridge).
# The browser/SPA never connects to Redis directly (it cannot hold credentials);
# only the backend does.
REDIS_PASSWORD=nova_redis_password
REDIS_AGENT_PASSWORD=nova_redis_agent_password
# Backend connection URLs. Keep the embedded password in sync with the values
# above (or override the whole URL for a managed endpoint).
REDIS_CACHE_URL=redis://:nova_redis_password@redis-cache:6379
REDIS_AGENT_URL=redis://:nova_redis_agent_password@redis-agent:6379
# When the rate-limit store is unreachable, allow requests through (true) rather
# than failing every request. Rate limiting is an availability control, not an
# authorization control. Set to false to fail closed.
REDIS_RATE_LIMIT_FAIL_OPEN=true

# ---- Seeding --------------------------------------------------------------
# When true, seeded data is deleted in dependency-safe order and reseeded.
# Only honoured outside production.
SEED_RESET=false

# ---- API ------------------------------------------------------------------
API_PORT=3000
# Comma-separated allowlist of browser origins permitted by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Max JSON body size accepted by the API.
API_BODY_LIMIT=100kb
# Sliding window rate limit (requests per window per client).
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120

# ---- Authentication (Keycloak / OIDC) -------------------------------------
# Issuer URL of the Keycloak realm. For local Docker this is the browser-facing
# URL so it matches the `iss` claim of tokens minted via http://localhost:8080.
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/nova
# Expected token audience(s), comma-separated.
KEYCLOAK_AUDIENCE=nova-api
# Explicit JWKS URI. In Docker the API resolves Keycloak by service name, since
# `localhost` inside the API container is not the Keycloak container.
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/nova/protocol/openid-connect/certs

# ---- Keycloak Admin REST (backend-driven user provisioning) ---------------
# The API provisions/syncs users + role mappings in Keycloak as the `nova-api`
# confidential client's service account (client_credentials). The browser never
# touches the Admin API. Provisioning is enabled only when a secret is set.
# Rotate KEYCLOAK_API_CLIENT_SECRET for any non-local environment.
KEYCLOAK_REALM=nova
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
KEYCLOAK_API_CLIENT_ID=nova-api
KEYCLOAK_API_CLIENT_SECRET=nova-api-dev-secret

# ---- Keycloak (local dev container) ---------------------------------------
# Bootstrap admin for the local Keycloak container ONLY. Never reuse in prod.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- Frontend (Vite, build-time) ------------------------------------------
# Only VITE_-prefixed values are inlined into the browser bundle. Never put
# Keycloak admin credentials or backend secrets here.
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=nova
VITE_KEYCLOAK_CLIENT_ID=nova-frontend
VITE_APP_NAME=Nova
