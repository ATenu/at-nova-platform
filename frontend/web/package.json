{
  "name": "@nova/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nova web frontend: React + TypeScript app for A2A chat, RBAC admin, sales, issues, actions, and SOP workflows.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
