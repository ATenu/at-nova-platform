# ----------------------------------------------------------------------------
# Nova web frontend environment (example). Copy to `.env` and adjust.
# Only VITE_-prefixed values are exposed to the browser bundle. Never put
# Keycloak admin credentials or backend service secrets here.
# ----------------------------------------------------------------------------

# Base URL of the Nova API. The existing backend serves under /api/v1.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Keycloak (OIDC) public client configuration.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=nova
VITE_KEYCLOAK_CLIENT_ID=nova-frontend

VITE_APP_NAME=Nova

# Local development only: when 'true', the app serves an in-browser mock API
# (MSW) and a mock auth session, so the UI runs without Keycloak or the backend.
# MUST be 'false' (or unset) in any deployed environment.
VITE_USE_MOCKS=true
