# SQL analyst agent configuration. Copy to `.env` and fill secrets locally.
# No secret in this file is a real credential.

AGENT_PORT=8003

# Inbound auth: this agent's audience and the only client allowed to task it.
KEYCLOAK_ISSUER_URL=http://keycloak:8080/realms/nova
# Defaults derived from the issuer if omitted:
# KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/nova/protocol/openid-connect/certs
# KEYCLOAK_TOKEN_URL=http://keycloak:8080/realms/nova/protocol/openid-connect/token
AGENT_AUDIENCE=nova-agent-sql-analyst
AGENT_AUTHORIZED_PARTIES=nova-celery-worker

# Outbound: client_credentials identity for reaching the entitlement endpoint
# and the DB MCP server (both audience nova-mcp-data).
AGENT_CLIENT_ID=nova-agent-sql-analyst
AGENT_CLIENT_SECRET=change-me
MCP_AUDIENCE_SCOPE=nova-mcp-data
# Dev realm injects audiences via protocol mappers on the agent client, so the
# agent must NOT forward the audience as an OAuth scope (else invalid_scope). Set
# true only in a realm that defines matching per-audience client scopes.
AGENT_REQUEST_AUDIENCE_SCOPES=false
# Audience for the Node capability tool gateway (the authoritative write path).
CAPABILITY_AUDIENCE_SCOPE=nova-mcp-sales

# Native A2A self-registration: publish this agent's card to the orchestrator on
# startup + heartbeat so it is discovered without static config (discovery only;
# authorization stays with the per-run snapshot + Layer B gate). The agent mints
# an ORCHESTRATOR_AUDIENCE_SCOPE token, so the realm must include a
# nova-orchestrator audience mapper on this agent client.
ORCHESTRATOR_INTERNAL_URL=http://orchestrator:8001
ORCHESTRATOR_AUDIENCE_SCOPE=nova-orchestrator
A2A_REGISTRATION_ENABLED=true
A2A_REGISTRATION_HEARTBEAT_SECONDS=60

# Downstream endpoints.
NOVA_API_INTERNAL_URL=http://nova-api:3000
DB_MCP_URL=http://db-mcp-server:8002

# Harness guardrails (bounded loop).
AGENT_MAX_ITERATIONS=6
AGENT_MAX_QUERIES=8
AGENT_STEP_TIMEOUT_S=30
AGENT_TOTAL_TIMEOUT_S=120

# LLM powering autonomous planning/reasoning/compose (OpenAI). Required.
OPENAI_API_KEY=change-me
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=30
# Optional: override the OpenAI-compatible base URL (e.g. a gateway/proxy).
# OPENAI_BASE_URL=
