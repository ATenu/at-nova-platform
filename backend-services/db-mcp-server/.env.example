# DB MCP server configuration. Copy to `.env` for local runs. NEVER commit real
# secrets. All values are validated at startup; the process will not boot on
# invalid configuration.

NODE_ENV=development
LOG_LEVEL=info

# HTTP server
MCP_DATA_PORT=8002
MCP_BODY_LIMIT=64kb
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX=120

# Read-only database connection — MUST be the nova_mcp_readonly role, NOT the
# business credentials. The role + password are provisioned by the
# McpReadDataSurface migration (MCP_READONLY_DB_PASSWORD passed to db-init).
MCP_READONLY_DATABASE_URL=postgres://nova_mcp_readonly:nova_mcp_readonly_password@localhost:5432/nova
MCP_READONLY_DB_SSL=false
MCP_READONLY_POOL_MAX=5

# Inbound auth: this resource server's audience and the only client allowed to
# call it (the SQL analyst agent).
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/nova
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/nova/protocol/openid-connect/certs
MCP_DATA_AUDIENCE=nova-mcp-data
MCP_DATA_AUTHORIZED_PARTIES=nova-agent-sql-analyst

# Outbound: fetch the verified entitlement snapshot from the control plane,
# authenticating as this server's own confidential client.
NOVA_API_INTERNAL_URL=http://localhost:3000
KEYCLOAK_TOKEN_URL=http://localhost:8080/realms/nova/protocol/openid-connect/token
KEYCLOAK_REALM=nova
MCP_DATA_CLIENT_ID=nova-mcp-data
MCP_DATA_CLIENT_SECRET=nova-mcp-data-dev-secret
ENTITLEMENT_AUDIENCE_SCOPE=nova-mcp-data

# SQL-safety limits
SQL_MAX_ROWS=500
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_RESULT_BYTES=1000000
