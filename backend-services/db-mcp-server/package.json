{
  "name": "@nova/db-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Nova DB MCP server: a production, spec-compliant MCP resource server exposing the data layer as secure, read-only tools over curated views.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nova/shared": "*",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pgsql-parser": "^17.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
