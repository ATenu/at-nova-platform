{
  "name": "@nova/db-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Nova MCP data-surfacer: read-only schema discovery and querying for A2A agents over the shared TypeORM data layer.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "surface-schema": "ts-node src/main.ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@nova/database": "*",
    "@nova/shared": "*",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
